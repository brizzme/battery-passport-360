# Optional local overrides. These defaults work without a .env file.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PASSWORD=local-demo

# Optional, server-side only: Claude briefing in the evidence assistant. Empty keeps the labelled offline mode.
# Only synthetic findings, statuses and public reference passages are sent.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
